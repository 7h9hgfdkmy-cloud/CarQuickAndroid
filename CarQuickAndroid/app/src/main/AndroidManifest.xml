<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <application android:label="車訊快捷助手" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:supportsRtl="true">
  <activity android:name=".MainActivity" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
  <service android:name=".LineService" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true" android:label="LINE 車訊懸浮助手">
   <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
   <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility"/>
  </service>
  <service android:name=".QuickIme" android:permission="android.permission.BIND_INPUT_METHOD" android:exported="true" android:label="車訊快捷鍵盤">
   <intent-filter><action android:name="android.view.InputMethod"/></intent-filter>
   <meta-data android:name="android.view.im" android:resource="@xml/keyboard"/>
  </service>
 </application>
</manifest>
